# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# Gemini
GEMINI_API_KEY=...

# GitHub
GITHUB_TOKEN=...
# Redis (optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# LLM Settings
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
